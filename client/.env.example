# ============================================================
# NexaTech Frontend — Vite Environment Variables
# Copy this file to .env for local development.
# For Vercel production deployment:
#   VITE_API_URL=https://YOUR-RENDER-BACKEND.onrender.com
#   VITE_AI_API_URL=https://YOUR-KOYEB-AI-SERVICE.koyeb.app (optional, if calling FastAPI directly)
# ============================================================

# Node / Express Backend Base URL
VITE_API_URL=http://localhost:5000

# Python / FastAPI AI Service URL (Optional if routed through backend proxy)
VITE_AI_API_URL=http://localhost:8000

# Google OAuth Client ID (Safe to expose in frontend)
VITE_GOOGLE_CLIENT_ID=
