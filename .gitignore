# Dependencies
node_modules/
**/node_modules/

# Environment variables (ignore real secrets everywhere)
.env
.env.*
.env.local
.env.development
.env.production
**/.env
**/.env.*
**/.env.local
**/.env.development
**/.env.production

# Explicitly keep example environment templates
!.env.example
!**/.env.example

# Python artifacts
.venv/
venv/
__pycache__/
**/__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
**/.pytest_cache/

# Logs
*.log
logs/

# Build files
dist/
**/dist/
build/
**/build/

# Vite cache
.vite/
**/.vite/

# OS files
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# Temporary files
*.tmp
*.temp