# Server Configuration
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development

# CORS Configuration (JSON array of allowed origins)
# React frontend runs on http://localhost:5173 by default in Vite
CORS_ORIGINS=["http://localhost:5173"]

# Google Gemini Dual-Key Configuration (Server-side ONLY)
# Never expose these keys to React frontend, GitHub, logs, or API responses.
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=

# Gemini Model Identifier (e.g., gemini-3.6-flash, gemini-2.0-flash, gemini-1.5-pro)
GEMINI_MODEL=gemini-3.6-flash

# Express Backend Product API
EXPRESS_BACKEND_URL=http://localhost:5000

# Path to trained machine learning model artifacts (when custom ML model is plugged in)
MODEL_PATH=models/trained_model.pkl

# Selected AI backend mode: 'llm', 'rule_based', or 'ml_model'
# When set to 'llm', uses Gemini dual keys with automatic failover.
MODEL_TYPE=llm
