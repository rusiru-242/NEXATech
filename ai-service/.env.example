# ============================================================
# NexaTech AI Service — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit real .env files with secrets.
#
# On Koyeb Production:
#   PORT is set automatically by Koyeb ($PORT).
#   ENVIRONMENT=production
#   FRONTEND_URL=https://YOUR-VERCEL-SITE.vercel.app
#   NODE_API_URL=https://YOUR-RENDER-BACKEND.onrender.com
#   GEMINI_API_KEY_1=<your-primary-gemini-key>
#   GEMINI_API_KEY_2=<your-backup-gemini-key>
#   GEMINI_MODEL=gemini-2.5-flash
# ============================================================

# Server
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development

# Frontend URL (for CORS allowlist)
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=[]

# Node.js / Express Backend URL (for product catalog)
NODE_API_URL=http://localhost:5000
EXPRESS_BACKEND_URL=http://localhost:5000

# Google Gemini Dual-Key Configuration (Server-side ONLY)
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_MODEL=gemini-2.5-flash

# MongoDB Atlas (Optional, if direct DB access is ever enabled)
MONGO_URI=

# ML Model Configuration
MODEL_PATH=
MODEL_TYPE=llm
